# Copy to .env.local for local development. On Vercel, set these in
# Project Settings -> Environment Variables. Never commit real values.

# Supabase project URL (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-only key that bypasses row level security. Use the secret key
# (sb_secret_...) or the legacy service_role key. Never expose it to the
# browser: do not prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Only used by scripts/tests that talk to Postgres directly (not by the app
# itself, which always goes through Supabase). Point this at a throwaway
# Postgres instance (e.g. `docker run -p 55433:5432 postgres:17`) to run the
# database-constraint and worker concurrency integration tests in
# src/test/db; those tests are skipped automatically when this is unset.
TEST_DATABASE_URL=

# Authenticates POST/GET /api/worker/tick. Named to match Vercel's own
# convention: when this is set on a Vercel project, Vercel Cron automatically
# sends `Authorization: Bearer <CRON_SECRET>` on its scheduled invocations, so
# no extra wiring is needed there. Generate with e.g. `openssl rand -hex 32`.
CRON_SECRET=

# Worker tuning (all optional; see docs/architecture.md's Phase 3 notes for
# the reasoning behind these defaults).
# Max runs claimed in a single tick.
# WORKER_BATCH_SIZE=5
# Max runs processed in parallel within a tick.
# WORKER_CONCURRENCY=3
# How long a claim is held before another worker may treat it as abandoned.
# WORKER_LEASE_SECONDS=120
# Wall-clock budget (ms) for a tick before unstarted claimed runs are backed off.
# WORKER_EXECUTION_BUDGET_MS=8000

# Phase 4 — external providers for the enrichment/classification/
# qualification/brief stages. Same env var names as this user's sibling
# portfolio project (ai-market-research-platform), reused deliberately for
# consistency rather than inventing new ones.

# Tavily search API key (https://app.tavily.com, free tier available) — the
# single web/company research provider (docs/architecture.md's Phase 4
# notes). Without it, the enrichment stage fails non-retryably with a clear
# "not configured" reason; leads still complete validation/normalization/
# dedup, they just won't progress past enrichment.
TAVILY_API_KEY=

# AI_PROVIDER selects which of the three interchangeable AI providers below
# is active: "gemini" | "groq" | "earthruntime". Defaults to "groq" if unset.
# Only the configured provider's own API key needs to be set.
# AI_PROVIDER=groq

# Groq (https://console.groq.com/keys) — OpenAI-compatible chat completions.
GROQ_API_KEY=
# Optional model override (default: openai/gpt-oss-120b).
# GROQ_MODEL=openai/gpt-oss-120b

# Gemini (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Optional model override (default: gemini-3.5-flash).
# GEMINI_MODEL=gemini-3.5-flash

# earthruntime (https://earthruntime.com) — also OpenAI-compatible, on
# dedicated inference hardware rather than reselling marketplace GPU
# capacity; a free tier is available with no card required.
EARTHRUNTIME_API_KEY=
# Optional model override (default: gpt-oss-120b — note no "openai/" prefix,
# unlike Groq's naming for the same underlying model).
# EARTHRUNTIME_MODEL=gpt-oss-120b
