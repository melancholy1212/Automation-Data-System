# Copy to .env.local for local development. On Vercel, set these in
# Project Settings -> Environment Variables. Never commit real values.

# Supabase project URL (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-only key that bypasses row level security. Use the secret key
# (sb_secret_...) or the legacy service_role key. Never expose it to the
# browser: do not prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Only used by scripts/tests that talk to Postgres directly (not by the app
# itself, which always goes through Supabase). Point this at a throwaway
# Postgres instance (e.g. `docker run -p 55433:5432 postgres:17`) to run the
# database-constraint integration tests in src/test/db; those tests are
# skipped automatically when this is unset.
TEST_DATABASE_URL=
